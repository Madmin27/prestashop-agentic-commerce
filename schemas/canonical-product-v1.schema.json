{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hepsiantep.com/schemas/canonical-product-v1.json",
  "title":"Hepsiantep Canonical Product v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","canonical_variant_id","product_group_id","category_type","source","context","timestamps","identity","content","commercial","verified_specs","declared_specs","derived_properties","suitability","evidence","media","links"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "canonical_variant_id":{"type":"string","minLength":1},
    "product_group_id":{"type":"string","minLength":1},
    "category_type":{"type":"string","minLength":1},
    "source":{"type":"object","additionalProperties":false,"required":["system","id_shop","id_product","id_product_attribute"],"properties":{"system":{"const":"prestashop"},"id_shop":{"type":"integer","minimum":1},"id_product":{"type":"integer","minimum":1},"id_product_attribute":{"type":"integer","minimum":0}}},
    "context":{"type":"object","additionalProperties":false,"required":["language","currency","pricing_context"],"properties":{"language":{"type":"string","minLength":2},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"pricing_context":{"type":"string","minLength":1}}},
    "timestamps":{"type":"object","additionalProperties":false,"required":["canonical_generated_at"],"properties":{"source_updated_at":{"type":["string","null"],"format":"date-time"},"canonical_generated_at":{"type":"string","format":"date-time"}}},
    "identity":{"type":"object","additionalProperties":false,"required":["title"],"properties":{"sku":{"type":["string","null"]},"gtin":{"type":["string","null"]},"mpn":{"type":["string","null"]},"brand":{"type":["string","null"]},"title":{"type":"string","minLength":1}}},
    "content":{"type":"object","additionalProperties":false,"required":["short_description","description"],"properties":{"short_description":{"type":["string","null"]},"description":{"type":["string","null"]}}},
    "variant_dimensions":{"type":"object","additionalProperties":true},
    "commercial":{"type":"object","additionalProperties":false,"required":["currency","sale_unit","availability","as_of","realtime_required"],"properties":{"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"price":{"type":["number","null"],"minimum":0},"sale_unit":{"type":"string","minLength":1},"min_order_quantity":{"type":["number","null"],"exclusiveMinimum":0},"availability":{"enum":["in_stock","out_of_stock","preorder","backorder","unknown"]},"stock_quantity":{"type":["number","null"]},"as_of":{"type":"string","format":"date-time"},"realtime_required":{"type":"boolean"}}},
    "verified_specs":{"type":"object","additionalProperties":true},
    "declared_specs":{"type":"object","additionalProperties":true},
    "derived_properties":{"type":"object","additionalProperties":{"type":"object","additionalProperties":false,"required":["value","method","rule_version","confidence"],"properties":{"value":{},"method":{"type":"string","minLength":1},"rule_version":{"type":"string","minLength":1},"confidence":{"type":"number","minimum":0,"maximum":1}}}},
    "suitability":{"type":"object","additionalProperties":false,"required":["recommended_for","conditionally_suitable_for","not_recommended_for"],"properties":{"recommended_for":{"$ref":"#/$defs/stringArray"},"conditionally_suitable_for":{"$ref":"#/$defs/stringArray"},"not_recommended_for":{"$ref":"#/$defs/stringArray"}}},
    "evidence":{"type":"object","additionalProperties":{"type":"array","items":{"$ref":"#/$defs/evidenceRecord"}}},
    "media":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["type","role","url"],"properties":{"type":{"enum":["image","video"]},"role":{"type":"string","minLength":1},"url":{"type":"string","format":"uri"},"alt":{"type":["string","null"]}}}},
    "links":{"type":"object","additionalProperties":false,"required":["canonical_web"],"properties":{"canonical_web":{"type":"string","format":"uri"},"realtime_api":{"type":["string","null"],"format":"uri"},"direct_cart":{"type":["string","null"],"format":"uri"},"image":{"type":["string","null"],"format":"uri"}}}
  },
  "$defs":{
    "stringArray":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "evidenceRecord":{"type":"object","additionalProperties":false,"required":["evidence_class","source_type","confidence","is_public","status"],"properties":{"evidence_class":{"enum":["verified","declared","derived"]},"source_type":{"type":"string","minLength":1},"source_id":{"type":["string","null"]},"source_url":{"type":["string","null"],"format":"uri"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_date":{"type":["string","null"],"format":"date"},"is_public":{"type":"boolean"},"status":{"enum":["active","superseded","revoked"]},"notes":{"type":["string","null"]}}}
  }
}
