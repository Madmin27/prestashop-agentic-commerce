      <trans-unit id="admin.023" approved="yes"><source>Eligible for search</source><target xml:lang="tr-TR" state="translated">Arama için uygun</target></trans-unit>
      <trans-unit id="admin.024" approved="yes"><source>Eligible for checkout</source><target xml:lang="tr-TR" state="translated">Ödeme için uygun</target></trans-unit>
      <trans-unit id="admin.025" approved="yes"><source>Privacy policy URL</source><target xml:lang="tr-TR" state="translated">Gizlilik politikası URL'si</target></trans-unit>
      <trans-unit id="admin.026" approved="yes"><source>Terms URL</source><target xml:lang="tr-TR" state="translated">Koşullar URL'si</target></trans-unit>
      <trans-unit id="admin.027" approved="yes"><source>Ads eligibility</source><target xml:lang="tr-TR" state="translated">Reklam uygunluğu</target></trans-unit>
      <trans-unit id="admin.028" approved="yes"><source>Not specified</source><target xml:lang="tr-TR" state="translated">Belirtilmedi</target></trans-unit>
      <trans-unit id="admin.029" approved="yes"><source>Eligible</source><target xml:lang="tr-TR" state="translated">Uygun</target></trans-unit>
      <trans-unit id="admin.030" approved="yes"><source>Not eligible</source><target xml:lang="tr-TR" state="translated">Uygun değil</target></trans-unit>
      <trans-unit id="admin.031" approved="yes"><source>OpenAI SFTP Delivery</source><target xml:lang="tr-TR" state="translated">OpenAI SFTP Gönderimi</target></trans-unit>
      <trans-unit id="admin.032" approved="yes"><source>Enter the SFTP values provided during merchant onboarding. Host-key verification is mandatory.</source><target xml:lang="tr-TR" state="translated">Satıcı onboarding sürecinde verilen SFTP bilgilerini girin. Sunucu anahtarı doğrulaması zorunludur.</target></trans-unit>
      <trans-unit id="admin.033" approved="yes"><source>Enable SFTP delivery</source><target xml:lang="tr-TR" state="translated">SFTP gönderimini etkinleştir</target></trans-unit>
      <trans-unit id="admin.034" approved="yes"><source>SFTP host</source><target xml:lang="tr-TR" state="translated">SFTP sunucusu</target></trans-unit>
      <trans-unit id="admin.035" approved="yes"><source>SFTP port</source><target xml:lang="tr-TR" state="translated">SFTP portu</target></trans-unit>
      <trans-unit id="admin.036" approved="yes"><source>Username</source><target xml:lang="tr-TR" state="translated">Kullanıcı adı</target></trans-unit>
      <trans-unit id="admin.037" approved="yes"><source>Authentication</source><target xml:lang="tr-TR" state="translated">Kimlik doğrulama</target></trans-unit>
      <trans-unit id="admin.038" approved="yes"><source>Account secret</source><target xml:lang="tr-TR" state="translated">Hesap parolası</target></trans-unit>
      <trans-unit id="admin.039" approved="yes"><source>SSH public key</source><target xml:lang="tr-TR" state="translated">SSH açık anahtarı</target></trans-unit>
      <trans-unit id="admin.040" approved="yes"><source>Authentication secret</source><target xml:lang="tr-TR" state="translated">Kimlik doğrulama parolası</target></trans-unit>
      <trans-unit id="admin.041" approved="yes"><source>Leave blank to keep the currently stored encrypted value.</source><target xml:lang="tr-TR" state="translated">Mevcut şifreli değeri korumak için boş bırakın.</target></trans-unit>
      <trans-unit id="admin.042" approved="yes"><source>Clear stored authentication secret</source><target xml:lang="tr-TR" state="translated">Kayıtlı kimlik doğrulama parolasını temizle</target></trans-unit>
      <trans-unit id="admin.043" approved="yes"><source>Private key file path</source><target xml:lang="tr-TR" state="translated">Özel anahtar dosya yolu</target></trans-unit>
      <trans-unit id="admin.044" approved="yes"><source>Public key file path</source><target xml:lang="tr-TR" state="translated">Açık anahtar dosya yolu</target></trans-unit>
      <trans-unit id="admin.045" approved="yes"><source>Private-key passphrase</source><target xml:lang="tr-TR" state="translated">Özel anahtar parolası</target></trans-unit>
      <trans-unit id="admin.046" approved="yes"><source>Clear stored key passphrase</source><target xml:lang="tr-TR" state="translated">Kayıtlı anahtar parolasını temizle</target></trans-unit>
      <trans-unit id="admin.047" approved="yes"><source>Remote file path</source><target xml:lang="tr-TR" state="translated">Uzak dosya yolu</target></trans-unit>
      <trans-unit id="admin.048" approved="yes"><source>SSH host key SHA256</source><target xml:lang="tr-TR" state="translated">SSH sunucu anahtarı SHA256</target></trans-unit>
      <trans-unit id="admin.049" approved="yes"><source>SSH host key MD5 fallback</source><target xml:lang="tr-TR" state="translated">SSH sunucu anahtarı MD5 yedeği</target></trans-unit>
      <trans-unit id="admin.050" approved="yes"><source>known_hosts file path</source><target xml:lang="tr-TR" state="translated">known_hosts dosya yolu</target></trans-unit>
      <trans-unit id="admin.051" approved="yes"><source>Transfer timeout (seconds)</source><target xml:lang="tr-TR" state="translated">Aktarım zaman aşımı (saniye)</target></trans-unit>
      <trans-unit id="admin.052" approved="yes"><source>Cron token</source><target xml:lang="tr-TR" state="translated">Cron tokenı</target></trans-unit>
      <trans-unit id="admin.053" approved="yes"><source>Use this only in the X-Agentic-Cron-Token HTTP header. Do not put it in the cron URL.</source><target xml:lang="tr-TR" state="translated">Bunu yalnızca X-Agentic-Cron-Token HTTP başlığında kullanın. Cron URL'sine eklemeyin.</target></trans-unit>
      <trans-unit id="admin.054" approved="yes"><source>Save settings</source><target xml:lang="tr-TR" state="translated">Ayarları kaydet</target></trans-unit>
      <trans-unit id="admin.055" approved="yes"><source>Yes</source><target xml:lang="tr-TR" state="translated">Evet</target></trans-unit>
      <trans-unit id="admin.056" approved="yes"><source>No</source><target xml:lang="tr-TR" state="translated">Hayır</target></trans-unit>
