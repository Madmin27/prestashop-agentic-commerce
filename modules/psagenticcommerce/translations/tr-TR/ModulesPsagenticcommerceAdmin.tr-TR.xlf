  <file original="modules/psagenticcommerce" source-language="en" target-language="tr-TR" datatype="plaintext">
    <body>
      <trans-unit id="admin.001" approved="yes"><source>PrestaShop Agentic Commerce</source><target xml:lang="tr-TR" state="translated">PrestaShop Agentik Ticaret</target></trans-unit>
      <trans-unit id="admin.002" approved="yes"><source>Canonical product data, AI JSON, UCP catalog and OpenAI product feed integration.</source><target xml:lang="tr-TR" state="translated">Kanonik ürün verisi, AI JSON, UCP katalog ve OpenAI ürün akışı entegrasyonu.</target></trans-unit>
      <trans-unit id="admin.003" approved="yes"><source>Uninstall the module? Canonical product metadata will be preserved; OpenAI connection credentials will be removed.</source><target xml:lang="tr-TR" state="translated">Modül kaldırılsın mı? Kanonik ürün meta verileri korunacak; OpenAI bağlantı kimlik bilgileri silinecektir.</target></trans-unit>
      <trans-unit id="admin.004" approved="yes"><source>Select a concrete shop before configuring this module.</source><target xml:lang="tr-TR" state="translated">Bu modülü yapılandırmadan önce belirli bir mağaza seçin.</target></trans-unit>
      <trans-unit id="admin.005" approved="yes"><source>OpenAI settings saved for this shop.</source><target xml:lang="tr-TR" state="translated">OpenAI ayarları bu mağaza için kaydedildi.</target></trans-unit>
      <trans-unit id="admin.006" approved="yes"><source>Snapshot complete: %d exported, %d skipped.</source><target xml:lang="tr-TR" state="translated">Anlık görüntü tamamlandı: %d dışa aktarıldı, %d atlandı.</target></trans-unit>
      <trans-unit id="admin.007" approved="yes"><source>SFTP upload completed.</source><target xml:lang="tr-TR" state="translated">SFTP yüklemesi tamamlandı.</target></trans-unit>
      <trans-unit id="admin.008" approved="yes"><source>OpenAI Feed Operations</source><target xml:lang="tr-TR" state="translated">OpenAI Ürün Akışı İşlemleri</target></trans-unit>
      <trans-unit id="admin.009" approved="yes"><source>Last delivery:</source><target xml:lang="tr-TR" state="translated">Son gönderim:</target></trans-unit>
      <trans-unit id="admin.010" approved="yes"><source>never</source><target xml:lang="tr-TR" state="translated">hiç yapılmadı</target></trans-unit>
      <trans-unit id="admin.011" approved="yes"><source>Generate snapshot</source><target xml:lang="tr-TR" state="translated">Anlık görüntü oluştur</target></trans-unit>
      <trans-unit id="admin.012" approved="yes"><source>Generate &amp; send by SFTP</source><target xml:lang="tr-TR" state="translated">Oluştur ve SFTP ile gönder</target></trans-unit>
      <trans-unit id="admin.013" approved="yes"><source>Cron endpoint:</source><target xml:lang="tr-TR" state="translated">Cron uç noktası:</target></trans-unit>
      <trans-unit id="admin.014" approved="yes"><source>Use POST with the X-Agentic-Cron-Token header. The token is intentionally not displayed here.</source><target xml:lang="tr-TR" state="translated">X-Agentic-Cron-Token başlığı ile POST kullanın. Token güvenlik nedeniyle burada gösterilmez.</target></trans-unit>
      <trans-unit id="admin.015" approved="yes"><source>OpenAI Merchant Feed</source><target xml:lang="tr-TR" state="translated">OpenAI Satıcı Ürün Akışı</target></trans-unit>
      <trans-unit id="admin.016" approved="yes"><source>These values are stored per shop and used to build the OpenAI full product snapshot.</source><target xml:lang="tr-TR" state="translated">Bu değerler mağaza bazında saklanır ve OpenAI tam ürün anlık görüntüsünü oluşturmak için kullanılır.</target></trans-unit>
      <trans-unit id="admin.017" approved="yes"><source>Seller name</source><target xml:lang="tr-TR" state="translated">Satıcı adı</target></trans-unit>
      <trans-unit id="admin.018" approved="yes"><source>Seller URL</source><target xml:lang="tr-TR" state="translated">Satıcı URL'si</target></trans-unit>
      <trans-unit id="admin.019" approved="yes"><source>Return policy URL</source><target xml:lang="tr-TR" state="translated">İade politikası URL'si</target></trans-unit>
